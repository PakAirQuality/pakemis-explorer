 "info": {
  "description": "Deterministic query API over one verified PakEmis semantic release. Every response is a pakemis_query Envelope with a replayable receipt; typed refusals are HTTP 422. Routes live under /api/v1/emissions; the same routes under /v1 are a deprecated alias for one release.",
  "title": "PakEmis Explorer API",
  "version": "0.1.0"
 },
 "openapi": "3.1.0",
 "paths": {
  "/api/v1/emissions/ask": {
   "post": {
    "operationId": "ask_api_v1_emissions_ask_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/AskBody"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {}
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Ask",
    "tags": [
     "ask"
    ]
   }
  },
  "/api/v1/emissions/claim": {
   "get": {
    "description": "The claim record behind one number: `?receipt=<r>&cell=<n>` replays the receipt and takes\ncell n; `?row_ids=<a,b,c>` names result rows directly. Every value is a string from a table of\nthe release; sections with nothing to show are null and listed under `missing`.",
    "operationId": "claim_api_v1_emissions_claim_get",
    "parameters": [
     {
      "in": "query",
      "name": "receipt",
      "required": false,
      "schema": {
       "default": "",
       "title": "Receipt",
       "type": "string"
      }
     },
     {
      "in": "query",
      "name": "cell",
      "required": false,
      "schema": {
       "default": 0,
       "title": "Cell",
       "type": "integer"
      }
     },
     {
      "in": "query",
      "name": "row_ids",
      "required": false,
      "schema": {
       "default": "",
       "title": "Row Ids",
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {}
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "Claim",
    "tags": [
     "lineage"
    ]
   }
  },
