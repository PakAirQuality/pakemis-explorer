 "info": {
  "description": "Deterministic query API over one verified PakEmis semantic release. Every response is a pakemis_query Envelope with a replayable receipt; typed refusals are HTTP 422. Routes live under /api/v1/emissions; the same routes under /v1 are a deprecated alias for one release.",
  "title": "PakEmis Explorer API",
  "version": "0.1.0"
 },
 "openapi": "3.1.0",
