   "QueryActivity": {
    "additionalProperties": false,
    "description": "A record from the activity tables behind the inventory (fact_activity_*): a count, a\nquantity or a rate AS ITS SOURCE PRINTED IT, with the definitions that make it readable -\nthe measure, the class, the place and its level, the period and its type, the unit, the\nevidence class, the source series and the use note. Never an emission and never converted:\na vehicle register is a registered stock, not traffic, and the use note says so. The one\narithmetic offered is `total`, a sum over the classes of ONE place at ONE date, marked as\ncomputed here and refused wherever the release says the rows may not be combined.",
    "properties": {
     "categories": {
      "items": {
       "type": "string"
      },
      "title": "Categories",
      "type": "array"
     },
     "limit": {
      "default": 0,
      "description": "0 -> the contract's row cap",
      "title": "Limit",
      "type": "integer"
     },
     "location_level": {
      "default": "",
      "description": "national | province | district | sales area | airport | plant; empty -> any level",
      "title": "Location Level",
      "type": "string"
     },
     "locations": {
      "items": {
       "type": "string"
      },
      "title": "Locations",
      "type": "array"
     },
     "measure": {
      "default": "",
      "description": "the table's Measure as printed (\"Registered vehicles\"); empty -> every measure",
      "title": "Measure",
      "type": "string"
     },
     "order_by": {
      "default": "",
      "description": "\"value desc\" | \"value asc\" | \"\"",
      "title": "Order By",
      "type": "string"
     },
     "periods": {
      "items": {
       "type": "string"
      },
      "title": "Periods",
      "type": "array"
     },
     "table": {
      "default": "",
      "description": "fact_activity_vehicles | fact_activity_livestock | ... (empty -> refused, with the list)",
      "title": "Table",
      "type": "string"
     },
     "total": {
      "default": false,
      "description": "true -> one more value after the rows: their sum, for one measure, place and period only",
      "title": "Total",
      "type": "boolean"
     }
    },
    "title": "QueryActivity",
    "type": "object"
   },
   "QueryAir": {
    "additionalProperties": false,
    "description": "The air tables: native kt of a named species, never CO2e. `periods` (fiscal) asks the\ncovered-sources family - the national panel and its province and district marginals -\nand `years` (calendar) the national agriculture series; a request naming neither is\nanswered for the reference period and says so. Which sectors a grain holds is read from\nits table, not listed here. A sum across pollutants is refused - the particulate strata\ncontain one another - so a request either filters to one pollutant or groups by it.",
    "properties": {
     "categories": {
      "items": {
       "type": "string"
      },
      "title": "Categories",
      "type": "array"
     },
     "configuration_id": {
      "default": "",
      "description": "panel + spatial by-year: REF_2023_24 (default) | S_HIES1925",
      "title": "Configuration Id",
      "type": "string"
     },
     "geography_ids": {
      "items": {
       "type": "string"
      },
      "title": "Geography Ids",
      "type": "array"
     },
     "geography_level": {
      "default": "",
      "description": "national | adm1 | adm2; empty -> national",
      "title": "Geography Level",
      "type": "string"
     },
     "group_by": {
      "items": {
       "type": "string"
      },
      "title": "Group By",
      "type": "array"
     },
     "limit": {
      "default": 0,
      "title": "Limit",
      "type": "integer"
     },
     "order_by": {
      "default": "",
      "title": "Order By",
      "type": "string"
     },
     "periods": {
      "items": {
       "type": "string"
      },
      "title": "Periods",
      "type": "array"
     },
     "pollutants": {
      "items": {
       "type": "string"
      },
      "title": "Pollutants",
      "type": "array"
     },
     "sectors": {
      "items": {
